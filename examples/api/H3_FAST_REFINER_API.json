    "inputs": {
      "clip": ["2", 0],
      "text": "Reproduce the input image exactly. Improve clarity only in existing real details: natural skin texture, individual hair strands, fabric weave, fur, and object edges. The source controls all content and geometry. Keep open eyes open and closed eyes closed. Keep the exact gaze, expression, identity, pose, anatomy, clothing, objects, text, crop, perspective, lighting, exposure, shadows, highlights, and colors. No retouching, relighting, redesign, grain, noise, scratches, cracks, patina, texture overlays, sharpening halos, added objects, or removed objects. Return the same photograph with clean natural detail."
    }
  },
  "7": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": ["6", 0]
    }
  },
  "8": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": ["4", 0],
      "vae": ["3", 0]
    }
  },
  "9": {
    "class_type": "ReferenceLatent",
    "inputs": {
      "conditioning": ["6", 0],
      "latent": ["8", 0]
    }
  },
  "10": {
